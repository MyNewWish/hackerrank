{
  "name": "hackerrank",
  "version": "0.1.0",
  "description": "Offline practice app for HackerRank-style Python screens",
  "author": "licanhuadev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "gen": "bun src/cli/gen.ts",
    "validate": "bun src/cli/validate.ts",
    "package": "bun scripts/package.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.57.0",
    "pyright": "^1.1.414",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.24.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "main": "./out/main/index.js",
  "build": {
    "appId": "dev.licanhua.hackerrank",
    "productName": "HackerRank",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pyright/**"
    ],
    "npmRebuild": false,
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
